{
  "scripts": {
    "start": "bun src/main.ts",
    "up": "docker compose --profile app up -d --build",
    "down": "docker compose --profile app down",
    "logs": "docker compose --profile app logs -f app",
    "db:up": "docker compose up -d postgres localstack",
    "db:test:create": "docker compose exec postgres psql -U postgres -c \"CREATE DATABASE wagering_test\" || true",
    "db:test:migrate": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wagering_test bunx --bun mikro-orm migration:up",
    "migration:up": "bunx --bun mikro-orm migration:up",
    "migration:down": "bunx --bun mikro-orm migration:down",
    "migration:pending": "bunx --bun mikro-orm migration:pending",
    "migration:list": "bunx --bun mikro-orm migration:list",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test src",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:http": "bun test test/http",
    "test:messaging": "bun test test/messaging",
    "test:recovery": "bun test test/recovery",
    "test:load": "bun scripts/load-test.ts"
  },
  "mikro-orm": {
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3",
    "@mikro-orm/core": "6",
    "@mikro-orm/migrations": "6",
    "@mikro-orm/postgresql": "6",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6",
    "@types/express": "^5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.3",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
